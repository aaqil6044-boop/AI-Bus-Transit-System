# Copy this file to .env and add your Google AI Studio key.
# Never commit the real .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional comma-separated stable fallbacks used after transient overloads.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Seconds to wait for Gemini's answer (3-60, default 15).
GEMINI_TIMEOUT=15
# Look up neighbourhoods/landmarks that are not BMTC stop names on OpenStreetMap (free). Set to off to disable.
GEOCODER=on
# Admin status page (/status). Always open on this computer; elsewhere add ?token=<this value>. Leave empty to keep it private.
STATUS_TOKEN=

# Background delay collector: asks BMTC about the 20 busiest routes, one route a minute, 6:00-22:00,
# so 'usually N min late' fills in faster. Set COLLECTOR=off to stop it.
COLLECTOR=on
# COLLECTOR_ROUTES=20
# COLLECTOR_SECONDS=60
# COLLECTOR_HOURS=6-22

# Rain forecast for trips (free Open-Meteo, no key). Set WEATHER=off to turn it off.
WEATHER=on
